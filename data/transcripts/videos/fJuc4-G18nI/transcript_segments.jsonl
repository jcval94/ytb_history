{"video_id": "fJuc4-G18nI", "segment_index": 12, "start_seconds": 42.2400016784668, "end_seconds": 47.040000915527344, "text": "An embarrassing track record for a country generally seen as relatively politically stable.", "transcription_model": "whisper-1"}
{"video_id": "fJuc4-G18nI", "segment_index": 13, "start_seconds": 47.68000030517578, "end_seconds": 50.0, "text": "So, in this video, we're going to have a look into this,", "transcription_model": "whisper-1"}
