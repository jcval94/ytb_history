{"video_id": "fJuc4-G18nI", "segment_index": 0, "start_seconds": 0.0, "end_seconds": 3.0399999618530273, "text": "When the Tories were voted out of office in 2024,", "transcription_model": "whisper-1"}
{"video_id": "fJuc4-G18nI", "segment_index": 1, "start_seconds": 3.0399999618530273, "end_seconds": 7.119999885559082, "text": "there was a feeling that this would bring an end to the chaos that they presided over.", "transcription_model": "whisper-1"}
{"video_id": "fJuc4-G18nI", "segment_index": 2, "start_seconds": 7.119999885559082, "end_seconds": 10.399999618530273, "text": "An end to the directionless governance. An end to the scandals.", "transcription_model": "whisper-1"}
{"video_id": "fJuc4-G18nI", "segment_index": 3, "start_seconds": 10.399999618530273, "end_seconds": 13.199999809265137, "text": "An end to the U-turns. An end to the broken promises.", "transcription_model": "whisper-1"}
