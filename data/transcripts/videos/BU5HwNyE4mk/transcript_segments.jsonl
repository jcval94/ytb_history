{"video_id": "BU5HwNyE4mk", "segment_index": 24, "start_seconds": 69.23999786376953, "end_seconds": 70.80000305175781, "text": "And although it was related,", "transcription_model": "whisper-1"}
{"video_id": "BU5HwNyE4mk", "segment_index": 25, "start_seconds": 70.80000305175781, "end_seconds": 72.4000015258789, "text": "it of course makes no mention", "transcription_model": "whisper-1"}
{"video_id": "BU5HwNyE4mk", "segment_index": 26, "start_seconds": 72.4000015258789, "end_seconds": 74.77999877929688, "text": "of the secret Janabekhov effect.", "transcription_model": "whisper-1"}
{"video_id": "BU5HwNyE4mk", "segment_index": 27, "start_seconds": 74.77999877929688, "end_seconds": 77.77999877929688, "text": "The paper says if you hold a tennis racket facing you", "transcription_model": "whisper-1"}
{"video_id": "BU5HwNyE4mk", "segment_index": 28, "start_seconds": 77.77999877929688, "end_seconds": 80.36000061035156, "text": "and then flip it in the air like this,", "transcription_model": "whisper-1"}
