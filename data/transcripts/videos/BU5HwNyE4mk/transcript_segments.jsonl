{"video_id": "BU5HwNyE4mk", "segment_index": 3, "start_seconds": 7.199999809265137, "end_seconds": 9.880000114440918, "text": "Now you may have seen clips like this one before,", "transcription_model": "whisper-1"}
{"video_id": "BU5HwNyE4mk", "segment_index": 4, "start_seconds": 9.880000114440918, "end_seconds": 11.800000190734863, "text": "but in this video, I will provide", "transcription_model": "whisper-1"}
