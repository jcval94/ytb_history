{"video_id": "BU5HwNyE4mk", "segment_index": 6, "start_seconds": 15.880000114440918, "end_seconds": 19.68000030517578, "text": "So in 1985, cosmonaut Vladimir Janabekhov", "transcription_model": "whisper-1"}
