{"video_id": "FhT8nxot2Es", "segment_index": 19, "start_seconds": 62.099998474121094, "end_seconds": 65.5, "text": "Los polarizados de izquierda y de derecha se parecen más entre sí", "transcription_model": "whisper-1"}
