{"video_id": "fkxoaD47-Vo", "segment_index": 0, "start_seconds": 0.0, "end_seconds": 5.840000152587891, "text": "Imagine all 8 billion people on earth are arranged into a circle, and say each person", "transcription_model": "whisper-1"}
