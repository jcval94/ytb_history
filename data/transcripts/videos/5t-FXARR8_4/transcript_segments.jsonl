{"video_id": "5t-FXARR8_4", "segment_index": 14, "start_seconds": 53.119998931884766, "end_seconds": 54.720001220703125, "text": "sobre los demás.", "transcription_model": "whisper-1"}
{"video_id": "5t-FXARR8_4", "segment_index": 15, "start_seconds": 54.720001220703125, "end_seconds": 59.08000183105469, "text": "Además del huerto aprendieron a aprovechar lo que la isla les ofrecía, recolectaban", "transcription_model": "whisper-1"}
