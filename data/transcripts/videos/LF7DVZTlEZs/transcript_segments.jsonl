{"video_id": "LF7DVZTlEZs", "segment_index": 6, "start_seconds": 22.15999984741211, "end_seconds": 24.280000686645508, "text": "Hoy las letras parecen inventarios de aduana.", "transcription_model": "whisper-1"}
{"video_id": "LF7DVZTlEZs", "segment_index": 7, "start_seconds": 24.280000686645508, "end_seconds": 27.559999465942383, "text": "Rolex, Ferrari, Gucci, Prada, Lamborghini.", "transcription_model": "whisper-1"}
{"video_id": "LF7DVZTlEZs", "segment_index": 8, "start_seconds": 27.559999465942383, "end_seconds": 30.84000015258789, "text": "El consumismo y la ostentación se volvieron tema central.", "transcription_model": "whisper-1"}
