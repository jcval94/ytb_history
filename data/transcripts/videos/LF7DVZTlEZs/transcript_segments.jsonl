{"video_id": "LF7DVZTlEZs", "segment_index": 0, "start_seconds": 0.0, "end_seconds": 2.1600000858306885, "text": "Gucci Gang, Gucci Gang, Gucci Gang.", "transcription_model": "whisper-1"}
