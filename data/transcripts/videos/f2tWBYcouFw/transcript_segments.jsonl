{"video_id": "f2tWBYcouFw", "segment_index": 2, "start_seconds": 6.599999904632568, "end_seconds": 10.239999771118164, "text": "Después le pidieron a grandes maestros y a jugadores principiantes que reconstruyeran", "transcription_model": "whisper-1"}
