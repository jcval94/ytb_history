{"video_id": "FNg5_5cXGmw", "segment_index": 6, "start_seconds": 26.239999771118164, "end_seconds": 30.15999984741211, "text": "Sin ruedas de prensa, sin conferencias, sin explicaciones para no expertos.", "transcription_model": "whisper-1"}
