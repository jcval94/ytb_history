{"video_id": "oRV5imUliSs", "segment_index": 2, "start_seconds": 6.440000057220459, "end_seconds": 10.920000076293945, "text": "Un estudio de Harvard analizó miles de emprendimientos exitosos en Estados Unidos.", "transcription_model": "whisper-1"}
