{"video_id": "6tiTNPOslzc", "segment_index": 0, "start_seconds": 0.0, "end_seconds": 5.360000133514404, "text": "Los soldados intercambian regalos, los británicos reparten chocolate, té y pudding,", "transcription_model": "whisper-1"}
