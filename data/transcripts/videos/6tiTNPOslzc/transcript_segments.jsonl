{"video_id": "6tiTNPOslzc", "segment_index": 6, "start_seconds": 23.440000534057617, "end_seconds": 28.399999618530273, "text": "Un partido lo ganaron los alemanes por 3 a 2, otro los ingleses 4 a 1.", "transcription_model": "whisper-1"}
{"video_id": "6tiTNPOslzc", "segment_index": 7, "start_seconds": 28.399999618530273, "end_seconds": 30.8799991607666, "text": "Probablemente una de las pocas veces en la historia", "transcription_model": "whisper-1"}
