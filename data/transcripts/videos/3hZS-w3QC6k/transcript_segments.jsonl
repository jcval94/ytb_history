{"video_id": "3hZS-w3QC6k", "segment_index": 0, "start_seconds": 0.0, "end_seconds": 2.359999895095825, "text": "Todo lo que les habían contado era mentira.", "transcription_model": "whisper-1"}
{"video_id": "3hZS-w3QC6k", "segment_index": 1, "start_seconds": 2.359999895095825, "end_seconds": 6.760000228881836, "text": "Después de hablar con ellos, creo que muchas de las cosas que dicen nuestros periódicos", "transcription_model": "whisper-1"}
